{
  "name": "pi-gateway",
  "version": "0.1.0",
  "description": "Pi extension gateway message bus with optional Telegram relay",
  "main": "dist/src/cli.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --outDir dist --noEmit false --declaration true"
  },
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "effect": "^3.21.2",
    "typebox": "^1.0.55",
    "xstate": "^5.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "bin": {
    "pi-gateway": "dist/src/cli.js",
    "pi-gateway-daemon": "dist/src/daemon.js",
    "pi-gateway-agent-worker": "dist/src/agent-worker.js"
  },
  "packageManager": "npm@10.9.3"
}
